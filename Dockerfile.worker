# syntax=docker/dockerfile:1.11
FROM golang:1.27.3-alpine AS builder
ENV GOWORK=off CGO_ENABLED=0
WORKDIR /app/apps/worker
COPY apps/worker/go.mod apps/worker/go.sum ./
COPY packages/config/go/go.mod packages/config/go/go.sum /app/packages/config/go/
COPY packages/db/go.mod packages/db/go.sum /app/packages/db/
RUN go mod download
COPY packages/config/go /app/packages/config/go
COPY packages/db /app/packages/db
COPY apps/worker ./
RUN go build -mod=readonly -trimpath -o /out/worker .

FROM gcr.io/distroless/static-debian12:nonroot AS runner
WORKDIR /app
ENV ZENITH_APPLICATION_ROOT=/app
COPY --from=builder --chown=65532:65532 /out/worker /app/worker
COPY --chown=65532:65532 config/config.yaml /app/config/config.yaml
USER 65532:65532
ENTRYPOINT ["/app/worker"]
