{
  "name": "web",
  "version": "0.1.0",
  "type": "module",
  "packageManager": "bun@1.4.2",
  "private": true,
  "scripts": {
    "gen:routes": "bun --no-env-file run scripts/generate-routes.ts",
    "dev": "bun --no-env-file run ../../packages/config/js/src/run.ts --development --runtime web --root ../.. --tool vite -- bun run vite",
    "build": "NODE_ENV=production bun --no-env-file run vite build",
    "build:vercel": "vite build",
    "start": "bun --no-env-file run ../../packages/config/js/src/run.ts --runtime web --root ../.. -- bun .output/server/index.mjs",
    "lint": "eslint",
    "check-types": "bun --no-env-file run ../../scripts/check-ui-primitives.ts && tsc --noEmit",
    "clean": "rm -rf .output .vite",
    "gen:client": "bun --no-env-file run openapi-ts"
  },
  "dependencies": {
    "@repo/brand": "*",
    "@repo/ui": "*",
    "@repo/ui-utils": "*",
    "@repo/config": "*",
    "@tailwindcss/vite": "^4.1.18",
    "@tanstack/react-query": "5.104.5",
    "@tanstack/react-router": "1.170.41",
    "@tanstack/react-start": "1.168.60",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "framer-motion": "^12.42.2",
    "lucide-react": "^0.562.0",
    "nitro": "3.0.260610-beta",
    "radix-ui": "^1.6.2",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tailwind-merge": "^3.0.2",
    "tailwindcss": "^4.1.18",
    "zod": "4.6.7",
    "@paper-design/shaders-react": "0.0.80"
  },
  "devDependencies": {
    "@hey-api/openapi-ts": "0.99.0",
    "@storybook/react": "10.6.2",
    "@repo/eslint-config": "*",
    "@repo/typescript-config": "*",
    "@tanstack/router-plugin": "1.168.42",
    "@tanstack/router-generator": "1.167.40",
    "@types/node": "^22.15.3",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "@vitejs/plugin-react": "6.0.3",
    "eslint": "^9.39.1",
    "typescript": "5.9.2",
    "vite": "8.1.6"
  }
}
