{
	"name": "bo",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"packageManager": "bun@1.4.2",
	"scripts": {
		"gen:client": "bun --no-env-file run openapi-ts",
		"gen:routes": "bun --no-env-file run scripts/generate-routes.ts",
		"dev": "bun --no-env-file run ../../packages/config/js/src/run.ts --development --runtime bo --root ../.. --tool vite -- bun run vite",
		"build": "NODE_ENV=production bun --no-env-file run vite build",
		"build:vercel": "vite build",
		"start": "bun --no-env-file run ../../packages/config/js/src/run.ts --runtime bo --root ../.. -- bun .output/server/index.mjs",
		"check-types": "bun --no-env-file run ../../scripts/check-ui-primitives.ts && tsc --noEmit"
	},
	"dependencies": {
		"@repo/brand": "*",
		"@repo/ui": "*",
		"@repo/ui-utils": "*",
		"@repo/config": "*",
		"@tanstack/react-query": "5.104.5",
		"@tanstack/react-router": "1.170.41",
		"@tanstack/react-start": "1.168.60",
		"react": "^19.2.0",
		"react-dom": "^19.2.0",
		"zod": "4.6.7",
		"tailwindcss": "^4.1.18",
		"@tailwindcss/vite": "^4.1.18",
		"nitro": "3.0.260610-beta",
		"lucide-react": "^0.562.0"
	},
	"devDependencies": {
		"@hey-api/openapi-ts": "0.99.0",
		"@storybook/react": "10.6.2",
		"@repo/typescript-config": "*",
		"@tanstack/router-plugin": "1.168.42",
		"@tanstack/router-generator": "1.167.40",
		"@types/node": "^22.15.3",
		"@types/react": "19.2.2",
		"@types/react-dom": "19.2.2",
		"@vitejs/plugin-react": "6.0.3",
		"typescript": "5.9.2",
		"vite": "8.1.6"
	}
}
