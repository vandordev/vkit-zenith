{
	"extends": "@repo/typescript-config/base.json",
	"compilerOptions": {
		"baseUrl": ".",
		"module": "ESNext",
		"moduleResolution": "Bundler",
		"jsx": "react-jsx",
		"noEmit": true,
		"paths": { "@bo/*": ["./src/*"] },
		"types": ["vite/client"]
	},
	"include": ["src/**/*.ts", "src/**/*.tsx", "vite.config.ts", "openapi-ts.config.ts", "scripts/**/*.ts"],
	"exclude": ["node_modules", ".output"]
}
