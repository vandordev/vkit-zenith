package projects

import (
	"context"
	"errors"
	"time"

	"github.com/jackc/pgx/v5"
)

type ArchiveInput struct{}
type ArchiveResult struct{}

// Archive validates its input before opening a transaction, then authorizes, locks, writes
// and audits inside it, so a failure leaves nothing behind.
func (s *Service) Archive(ctx context.Context, in ArchiveInput) (ArchiveResult, error) {
	var out ArchiveResult
	err := s.transaction(ctx, func(ctx context.Context, tx pgx.Tx, at time.Time) error {
		// Authorize the actor, lock rows in a fixed order, write with the queries in
		// archive.sql and record the audit event, all before returning.
		return errors.New("projects.Archive: not implemented")
	})
	return out, err
}
