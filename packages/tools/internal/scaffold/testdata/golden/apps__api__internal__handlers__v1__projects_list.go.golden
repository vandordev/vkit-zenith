//vkit:handler
func NewListProjects(api huma.API) error {
	huma.Register(api, huma.Operation{
		OperationID: "listProjects", Method: http.MethodGet, Path: "/v1/projects",
		Security: []map[string][]string{{"bearerAuth": {}}},
		Errors:   []int{http.StatusUnauthorized, http.StatusNotFound, http.StatusNotImplemented},
	}, func(ctx context.Context, in *V1ProjectsListInput) (*V1ProjectsListOutput, error) {
		// The key's organization scopes every read (ADR-0002).
		if _, err := bearerOrg(in.Authorization); err != nil {
			return nil, err
		}
		// Read through this API's sqlc persistence: add projects_list.sql beside this file, run
		// `task gen:db`, and scope every query by the caller (ADR-0002, ADR-0004).
		return nil, Problem(http.StatusNotImplemented, "not_implemented")
	})
	return nil
}
