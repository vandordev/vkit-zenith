// Package {{.Domain}} owns {{.Domain}} mutations: validation, authorization, ordered locks,
// one transaction and the audit event (ADR-0004). This domain is registered in
// packages/application/sqlc.yaml; after writing its SQL, run `task gen:db`.
package {{.Domain}}

import (
	"context"
	"time"

	"github.com/jackc/pgx/v5"
	"github.com/jackc/pgx/v5/pgxpool"
	db "github.com/vandordev/vkit-zenith/packages/db"
)

type Service struct {
	pool  *pgxpool.Pool
	clock func() time.Time
}

func NewService(pool *pgxpool.Pool, clock func() time.Time) *Service {
	if pool == nil || clock == nil {
		panic("{{.Domain}}: explicit dependencies required")
	}
	return &Service{pool: pool, clock: clock}
}

// transaction runs fn in one bounded transaction with a single accepted time for every write.
func (s *Service) transaction(ctx context.Context, fn func(context.Context, pgx.Tx, time.Time) error) error {
	return db.InTx(ctx, s.pool, pgx.TxOptions{}, func(ctx context.Context, tx pgx.Tx) error {
		if _, err := tx.Exec(ctx, `SET LOCAL lock_timeout='5s';SET LOCAL statement_timeout='15s'`); err != nil {
			return err
		}
		return fn(ctx, tx, s.clock().UTC())
	})
}
