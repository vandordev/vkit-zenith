{
	"extends": "@repo/typescript-config/base.json",
	"compilerOptions": {
		"allowJs": true,
		"module": "ESNext",
		"moduleResolution": "Bundler",
		"jsx": "react-jsx",
		"noEmit": true,
		"types": ["node", "bun", "vite/client"]
	},
	"include": ["src/**/*.ts", "src/**/*.tsx", "src/**/*.mjs", "previews/**/*.mjs", "scripts/**/*.ts"]
}
