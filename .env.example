# Explicitly loaded by development launchers only; injected values take precedence.
# Required only for explicit database operations. No fallback credentials.
# Use a PostgreSQL URL; choose TLS explicitly (verify-full for remote operation).
DB_DSN=
WORKER_SHUTDOWN_TIMEOUT_SECONDS=30
WORKER_MAX_WORKERS=10
R2_ENDPOINT=
R2_REGION=auto
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_PRESIGN_TTL_SECONDS=300
# <id>:<base64-encoded 32-byte nonzero key>; first entry is active.
ZENITH_KEK_ACTIVE=
NODE_ENV=development
LOG_LEVEL=info
BO_HOST=0.0.0.0
BO_PORT=4103
BO_ORIGIN=http://localhost:4103
BO_API_HOST=0.0.0.0
BO_API_PORT=4104
BO_API_BASE_URL=http://localhost:4104
# Explicit loopback-only development transport; never staging/production.
BO_API_DEVELOPMENT=true
BO_API_DOCS_ENABLED=true
BO_API_DOCS_USERNAME=
BO_API_DOCS_PASSWORD=
# Provision >=32 random bytes out of band; no repository secret/default.
BO_API_CSRF_SECRET=
WEB_HOST=0.0.0.0
WEB_PORT=4100
WEB_API_HOST=0.0.0.0
WEB_API_PORT=4101
WEB_API_DOCS_ENABLED=false
WEB_API_DOCS_USERNAME=
WEB_API_DOCS_PASSWORD=
WEB_API_READ_TIMEOUT_SECONDS=15
WEB_API_WRITE_TIMEOUT_SECONDS=30
WEB_API_IDLE_TIMEOUT_SECONDS=60
WEB_API_SHUTDOWN_TIMEOUT_SECONDS=10
PUBLIC_API_HOST=0.0.0.0
PUBLIC_API_PORT=4102
PUBLIC_API_DOCS_ENABLED=false
PUBLIC_API_DOCS_USERNAME=
PUBLIC_API_DOCS_PASSWORD=
PUBLIC_API_READ_TIMEOUT_SECONDS=15
PUBLIC_API_WRITE_TIMEOUT_SECONDS=30
PUBLIC_API_IDLE_TIMEOUT_SECONDS=60
PUBLIC_API_SHUTDOWN_TIMEOUT_SECONDS=10

API_BASE_URL=http://localhost:4101

# Web browser origin selected by Web API identity (same-site HTTPS in production).
IDENTITY_AUTH_ORIGIN=https://web.example.test

